# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=69c126bb001b112e80ad

# Server-side Appwrite credentials (required for reliable API writes in production)
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=69c126bb001b112e80ad
APPWRITE_API_KEY=your_appwrite_server_api_key
APPWRITE_DATABASE_ID=ceylonupdates_db
APPWRITE_COMMENTS_COLLECTION_ID=comments

# Appwrite Collection IDs (create these in your Appwrite console)
NEXT_PUBLIC_APPWRITE_DATABASE_ID=ceylonupdates_db
NEXT_PUBLIC_APPWRITE_ARTICLES_COLLECTION_ID=articles
NEXT_PUBLIC_APPWRITE_CATEGORIES_COLLECTION_ID=categories
NEXT_PUBLIC_APPWRITE_TAGS_COLLECTION_ID=tags
NEXT_PUBLIC_APPWRITE_COMMENTS_COLLECTION_ID=comments
NEXT_PUBLIC_APPWRITE_SUBSCRIBERS_COLLECTION_ID=subscribers
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=newsstor
NEXT_PUBLIC_ADMIN_EMAILS=ts1@gmail.com,ts2@gmail.com

# Google Services
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# Site Config
NEXT_PUBLIC_SITE_URL=https://www.ceylonupdates.me
NEXT_PUBLIC_SITE_NAME=CeylonUpdates.me

# AI Providers (Admin - Multi fallback)
# Requested default flow:
# openrouter (free) -> gemini -> groq -> ollama
# You can still include hf/openai if needed.
AI_PROVIDER_ORDER=openrouter,gemini,groq,ollama,hf,openai

# OpenRouter Free (priority 1)
OPENROUTER_FREE_AVAILABLE=true
OPENROUTER_API_KEY=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
OPENROUTER_FREE_MODEL=google/gemma-2-9b-it:free
OPENROUTER_MODEL=openai/gpt-4o-mini

# Gemini (priority 2)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq (priority 3)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama local model (priority 4)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Hugging Face
HF_TOKEN=your_huggingface_token
HF_MODEL=deepseek-ai/DeepSeek-V3-0324:novita

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
